# ---------------------------------------------------------------------------
# Copy to .env for local development. On Render/Railway set these as env vars.
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://hotel.example.com
# Public URL of this site (used in emails and as the default M-Pesa callback base)
SITE_URL=http://localhost:8000
# DATABASE_URL=postgres://user:pass@host:5432/hoteli   (defaults to SQLite)
# …or discrete settings (used by AWS and docker compose): DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD, DB_SSLMODE
# Single-server docker compose only:
# DOMAIN=book.myhotel.co.ke
# DB_PASSWORD=a-long-random-password
# Behind CloudFront set SECURE_PROXY_SSL_HEADER_NAME=HTTP_CLOUDFRONT_FORWARDED_PROTO
# Background jobs (python manage.py run_jobs): NIGHT_AUDIT_TIME=23:30
TIME_ZONE=Africa/Nairobi

# First administrator (created by `python manage.py ensure_admin`)
# DJANGO_ADMIN_USERNAME=admin
# DJANGO_ADMIN_PASSWORD=a-strong-password

# --- Email (console backend prints emails to the terminal by default) -------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=Hoteli Grand <reservations@example.com>

# --- M-Pesa (Safaricom Daraja) ---------------------------------------------
# Leave the consumer key/secret empty to run in SIMULATION mode (no real money).
MPESA_ENVIRONMENT=sandbox                 # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379                    # sandbox Lipa Na M-Pesa Online shortcode
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for a Till
# MPESA_TILL_NUMBER=                      # Buy Goods only: till that receives the money
# MPESA_C2B_SHORTCODE=600000              # Paybill used for C2B (defaults to MPESA_SHORTCODE)
# Public HTTPS URL Safaricom can reach (your domain, or an ngrok tunnel locally)
MPESA_CALLBACK_BASE_URL=https://your-tunnel.ngrok-free.app
# Long random secret that is part of every callback URL
MPESA_CALLBACK_TOKEN=replace-with-a-long-random-string
# MPESA_SIMULATE=False                    # force simulation on/off
# MPESA_QUERY_AFTER_SECONDS=20
# MPESA_STK_TIMEOUT_SECONDS=180
